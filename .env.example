# PostgreSQL connection string used by Prisma.
# Replace USER, PASSWORD, HOST, PORT, and DATABASE with your local or hosted PostgreSQL details.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js secret used to sign/encrypt auth tokens. Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"

# First admin user seed values. Do not commit real credentials.
ADMIN_NAME="Admin User"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Cloudinary credentials used by protected admin uploads.
# Keep CLOUDINARY_API_SECRET server-side only and never expose it with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
