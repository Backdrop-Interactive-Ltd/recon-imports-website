generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum VehicleCategoryType {
  BODY_TYPE
  STOCK_TYPE
  PREFERENCE
}

enum CarBodyType {
  SEDAN
  HATCHBACK
  SUV
  CROSSOVER
  MPV
  PASSENGER_VAN
  WAGON
  OTHER
}

enum FuelType {
  OCTANE
  DIESEL
  ELECTRIC
  HYBRID
  OCTANE_HYBRID
  OTHER
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
  CVT
  E_CVT
  SEMI_AUTOMATIC
  TIPTRONIC
  OTHER
}

enum CarCondition {
  BRAND_NEW
  PRE_OWNED
  RECONDITIONED
  USED
}

enum StockType {
  BRAND_NEW
  PRE_OWNED
  PRE_ORDER
  RECONDITIONED
}

enum CarFeatureType {
  FEATURE
  SAFETY
}

enum CarSaleStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum SiteSettingType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  JSON
  URL
  IMAGE_URL
}

enum LeadStatus {
  NEW
  REVIEWED
  CONTACTED
  IN_PROGRESS
  CLOSED
  SPAM
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum AuctionSheetStatus {
  NEW
  PROCESSING
  REPORT_READY
  COMPLETED
  CANCELLED
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  employeeProfiles EmployeePublicProfile[] @relation("EmployeeProfileCreator")
  employeeSubmissions EmployeePublicProfile[] @relation("EmployeeProfileSubmitter")
  employeeReviews EmployeePublicationApproval[] @relation("EmployeeApprovalReviewer")
  employeeAuditEvents EmployeeAuditEvent[] @relation("EmployeeAuditActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cars      Car[]

  @@index([isActive])
}

model VehicleCategory {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String?
  imageUrl       String?
  imageAlt       String?
  routePath      String?
  iconKey        String?
  type           VehicleCategoryType
  showOnHomepage Boolean             @default(true)
  isActive       Boolean             @default(true)
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([type])
  @@index([showOnHomepage])
  @@index([isActive])
  @@index([sortOrder])
}

model Car {
  id            String           @id @default(cuid())
  title         String
  slug          String           @unique
  brandId       String
  chassisNumber String?
  model         String
  year          Int
  price         Int
  mileage       String
  bodyType      CarBodyType
  fuelType      FuelType
  transmission  TransmissionType
  condition     CarCondition
  origin        String?
  grade         String?
  location      String?
  packageName   String?
  stockType     StockType
  exteriorColor String?
  interiorColor String?
  engine        String?
  driveTrain    String?
  wheelSize     String?
  description   String?
  videoImageUrl String?
  youtubeVideoUrl String?
  isFeatured    Boolean          @default(false)
  isPublished   Boolean          @default(false)
  saleStatus    CarSaleStatus    @default(AVAILABLE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  brand         Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images        CarImage[]
  features      CarFeature[]

  @@index([brandId])
  @@index([chassisNumber])
  @@index([bodyType])
  @@index([stockType])
  @@index([condition])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([saleStatus])
  @@index([year])
  @@index([price])
}

model CarImage {
  id        String   @id @default(cuid())
  carId     String
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@index([isPrimary])
  @@index([sortOrder])
}

model CarFeature {
  id        String         @id @default(cuid())
  carId     String
  title     String
  type      CarFeatureType
  sortOrder Int            @default(0)
  car       Car            @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@index([type])
  @@index([sortOrder])
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  ctaText   String?
  ctaLink   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model SiteSetting {
  id        String          @id @default(cuid())
  key       String          @unique
  value     String
  type      SiteSettingType @default(STRING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  fileUrl   String
  fileName  String
  fileType  String
  folder    String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([createdAt])
}

model SellCarLead {
  id               String     @id @default(cuid())
  name             String
  phone            String
  carName          String
  model            String?
  registrationYear String?
  mileage          String?
  offeredPrice     String?
  imageUrls        String[]   @default([])
  status           LeadStatus @default(NEW)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model RequirementLead {
  id        String     @id @default(cuid())
  name      String
  phone     String
  carName   String
  model     String?
  modelYear String?
  mileage   String?
  details   String?
  imageUrls String[]   @default([])
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AuctionSheetRequest {
  id            String             @id @default(cuid())
  chassisNumber String
  name          String
  phone         String
  email         String
  feeAmount     Int                @default(800)
  paymentMethod String?
  senderNumber  String?
  transactionId String?
  paymentStatus PaymentStatus      @default(PENDING)
  status        AuctionSheetStatus @default(NEW)
  reportUrl     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([chassisNumber])
  @@index([email])
  @@index([paymentStatus])
  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

enum EmployeeEmploymentStatus {
  ACTIVE
  INACTIVE
  FORMER
}
enum EmployeeProfileState {
  DRAFT
  SUBMITTED
  ERASED
}
enum EmployeePublicationScope {
  DIRECTORY
  VERIFICATION
}
enum EmployeeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}
enum EmployeeAuditEventType {
  CREATED
  DRAFT_SAVED
  REVISION_SUBMITTED
  APPROVAL_REQUESTED
  REVISION_APPROVED
  REVISION_REJECTED
  PROFILE_PUBLISHED
  PROFILE_UNPUBLISHED
  APPROVAL_WITHDRAWN
  CONSENT_WITHDRAWN
  STATUS_CHANGED
  DEPARTMENT_CHANGED
  IDENTITY_ISSUED
  IDENTITY_RETIRED
  ARCHIVED
  RESTORED
  PERSONAL_DATA_ERASED
}
model Department {
  id String @id @default(cuid())
  name String @db.VarChar(120)
  slug String @unique @db.VarChar(120)
  displayOrder Int @default(0)
  isActive Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  employees Employee[]
  profileRevisions EmployeePublicProfile[]
  @@index([isActive, displayOrder, id])
}
model Employee {
  id String @id @default(cuid())
  employeeCode String @unique @db.VarChar(32)
  internalName String? @db.VarChar(160)
  departmentId String?
  employmentStatus EmployeeEmploymentStatus @default(INACTIVE)
  statusChangedAt DateTime @default(now()) @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  personalDataErasedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  revisionCounter Int @default(0)
  publicationEpoch Int @default(1)
  reactivationApprovalIds String[] @default([])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  profiles EmployeePublicProfile[]
  identities EmployeeVerificationIdentity[]
  auditEvents EmployeeAuditEvent[]
  @@index([departmentId, employmentStatus, archivedAt, id])
  @@index([employmentStatus, archivedAt, id])
}
model EmployeePublicProfile {
  id String @id @default(cuid())
  employeeId String
  revision Int
  state EmployeeProfileState @default(DRAFT)
  version Int @default(1)
  publicName String? @db.VarChar(160)
  designation String? @db.VarChar(160)
  biography String? @db.VarChar(2000)
  experienceSummary String? @db.VarChar(500)
  departmentId String?
  departmentName String? @db.VarChar(120)
  portraitStorageKey String? @db.VarChar(300)
  portraitStorageVersion String? @db.VarChar(100)
  officialPhone String? @db.VarChar(40)
  officialEmail String? @db.VarChar(254)
  displayOrder Int @default(0)
  isFeatured Boolean @default(false)
  createdById String?
  submittedById String?
  submittedBySnapshot String? @db.VarChar(180)
  submittedAt DateTime? @db.Timestamptz(3)
  erasedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy AdminUser? @relation("EmployeeProfileCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  submittedBy AdminUser? @relation("EmployeeProfileSubmitter", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  approvals EmployeePublicationApproval[]
  @@unique([employeeId, revision])
  @@index([employeeId, state])
  @@index([departmentId, displayOrder, id])
  @@index([createdById])
  @@index([submittedById])
}
model EmployeeVerificationIdentity {
  id String @id @default(cuid())
  employeeId String
  publicKey String @unique @db.VarChar(32)
  issuedAt DateTime @default(now()) @db.Timestamptz(3)
  retiredAt DateTime? @db.Timestamptz(3)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([employeeId, issuedAt])
}
model EmployeePublicationApproval {
  id String @id @default(cuid())
  employeeId String
  profileRevision Int
  employmentEpoch Int
  scope EmployeePublicationScope
  status EmployeeApprovalStatus @default(PENDING)
  isPublished Boolean @default(false)
  publishedAt DateTime? @db.Timestamptz(3)
  withdrawnAt DateTime? @db.Timestamptz(3)
  publishPortrait Boolean @default(false)
  publishPhone Boolean @default(false)
  publishEmail Boolean @default(false)
  consentReference String? @db.VarChar(200)
  consentPolicyVersion String? @db.VarChar(40)
  consentRecordedAt DateTime? @db.Timestamptz(3)
  consentExpiresAt DateTime? @db.Timestamptz(3)
  evidenceErasedAt DateTime? @db.Timestamptz(3)
  decidedById String?
  decidedBySnapshot String? @db.VarChar(180)
  decidedAt DateTime? @db.Timestamptz(3)
  selfApproved Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  profile EmployeePublicProfile @relation(fields: [employeeId, profileRevision], references: [employeeId, revision], onDelete: Restrict, onUpdate: Restrict)
  decidedBy AdminUser? @relation("EmployeeApprovalReviewer", fields: [decidedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  @@index([employeeId, scope, createdAt])
  @@index([scope, status, isPublished, employeeId])
  @@index([consentReference])
  @@index([decidedById])
}
model EmployeeAuditEvent {
  id String @id @default(cuid())
  employeeId String
  actorAdminId String?
  actorSnapshot String @db.VarChar(180)
  actorRole AdminRole
  eventType EmployeeAuditEventType
  profileRevision Int?
  recordVersion Int
  changedFields String[] @default([])
  summary String @db.VarChar(240)
  correlationId String @db.VarChar(100)
  isSelfApproval Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorAdmin AdminUser? @relation("EmployeeAuditActor", fields: [actorAdminId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  @@index([employeeId, createdAt, id])
  @@index([actorAdminId, createdAt])
}
