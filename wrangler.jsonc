{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recon-imports-website",
  "routes": [{ "pattern": "www.reconimports.com", "custom_domain": true }],
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "recon-imports-website" }],
  // Existing resource: recon-imports-production-db. Query caching must be
  // disabled on the Hyperdrive resource to keep authorization reads fresh.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "02364ff5b23e47a8889958733e06d1da" }
  ],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "recon-imports-next-cache" }],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  // Cloudflare Durable Object declarations, not PostgreSQL migrations.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  "images": { "binding": "IMAGES" },
  // AUTH_SECRET, AUTH_URL and Cloudinary credentials are secrets, not vars here.
  "vars": { "NEXTJS_ENV": "production" }
}
